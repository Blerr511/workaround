{
  "sourceMaps": true,
  "$schema": "http://json.schemastore.org/swcrc",
  "module": {
    "type": "commonjs",
    "noInterop": true
  },
  "jsc": {
    "externalHelpers": false,
    "target": "es2018",
    "parser": {
      "importAssertions": false,
      "syntax": "typescript",
      "tsx": false,
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "keepClassNames": true,
    "loose": false,
    "preserveAllComments": true
  }
}
