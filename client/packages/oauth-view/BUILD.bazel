load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//client/packages/oauth-view:rollup/package_json.bzl", _rollup = "bin")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "build_srcs",
    srcs = [
        "package.json",
        ":node_modules",
    ] + glob([
        "src/**/*.ts",
        "src/**/*.tsx",
    ]) + ["index.ts"] + glob([
        "public/**",
        "src/**/*.css",
    ]),
)

_rollup.rollup(
    name = "build",
    srcs = [
        "package.json",
        "rollup.config.js",
        "swc.config.json",
        "tsconfig.json",
        ":build_srcs",
    ],
    args = [
        "-c",
        "$(location rollup.config.js)",
        "--bundleConfigAsCjs",
    ],
    env = {
        "ROOT_PATH": package_name(),
    },
    out_dirs = ["dist"],
    tags = ["requires-network"],
)

# make this library available via node_modules
npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":build",
    ],
    # This is a perf improvement; the default will be flipped to False in rules_js 2.0
    include_runfiles = False,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "npm.publish",
    srcs = [
        "//tools/npm:npm_cli",
    ],
    args = [
        "publish",
        "$(location :ui)",
        # "--dry-run",
    ],
    data = [
        ":ui",
        "//tools/gcloud:npmrc",
    ],
    env = {
        "NPM_CONFIG_USERCONFIG": "$(location //tools/gcloud:npmrc)",
    },
    tags = ["requires-network"],
)

filegroup(
    name = "oauth-view.json",
    srcs = [":package.json"],
    visibility = ["//visibility:public"],
)
